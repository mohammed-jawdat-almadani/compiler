{% extends "base.jinja" %}
{% block title %}Edit Product{% endblock %}

{% block content %}
{% if product %}
<div class="h1">Edit: {{ product.name }}</div>
<div class="muted">Update the product information and save.</div>

<div class="split" style="margin-top:14px;">
  <div class="panel">
    <div class="img" style="border-radius: 12px; overflow:hidden;">
      <img src="{{ url_for('static', filename='images/' ~ product.image) }}" alt="{{ product.name }}">
    </div>
  </div>

  <div class="panel">
    <form class="form" method="post" action="{{ url_for('edit_product', product_id=product.id) }}">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" type="text" name="name" value="{{ product.name }}" required>
      </div>

      <div class="field">
        <label for="price">Price</label>
        <input id="price" type="number" name="price" value="{{ product.price }}" required>
      </div>

      <div class="field">
        <label for="details">Details</label>
        <textarea id="details" name="details" required>{{ product.details }}</textarea>
      </div>

      <div class="field">
        <label for="image">Image filename</label>
        <input id="image" type="text" name="image" value="{{ product.image }}" required>
      </div>

      <div class="actions">
        <button class="btn primary" type="submit">Save</button>
        <a class="btn" href="{{ url_for('index') }}">Back</a>
        <a class="btn danger" href="{{ url_for('delete_product', product_id=product.id) }}" onclick="return confirmDelete()">Delete</a>
      </div>
    </form>
  </div>
</div>
{% else %}
<div class="h1">Product not found</div>
<div class="muted">The requested product ID does not exist.</div>
<div class="actions" style="margin-top:14px;">
  <a class="btn" href="{{ url_for('index') }}">Back to products</a>
</div>
{% endif %}
{% endblock %}
