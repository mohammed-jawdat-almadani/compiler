{% extends "base.jinja" %}
{% block title %}Product Details{% endblock %}

{% block content %}
{% if product %}
<div class="h1">{{ product.name }}</div>
<div class="muted">Product details page</div>

<div class="split" style="margin-top:14px;">
  <div class="panel">
    <div class="img" style="border-radius: 12px; overflow:hidden;">
      <img src="{{ url_for('static', filename='images/' ~ product.image) }}" alt="{{ product.name }}">
    </div>
  </div>

  <div class="panel">
    <div class="price" style="margin-bottom:10px;">
      <span class="badge">Price</span>
      <span>{{ product.price }}$</span>
      {% if product.price > 1000 %}<span class="badge">Premium</span>{% endif %}
    </div>

    <div class="muted" style="white-space: pre-wrap;">{{ product.details }}</div>

    <div class="actions" style="margin-top:14px;">
      <a class="btn" href="{{ url_for('index') }}">Back</a>
      <a class="btn primary" href="{{ url_for('edit_product', product_id=product.id) }}">Edit</a>
      <a class="btn danger" href="{{ url_for('delete_product', product_id=product.id) }}" onclick="return confirmDelete()">Delete</a>
    </div>
  </div>
</div>
{% else %}
<div class="h1">Product not found</div>
<div class="muted">The requested product ID does not exist.</div>
<div class="actions" style="margin-top:14px;">
  <a class="btn" href="{{ url_for('index') }}">Back to products</a>
</div>
{% endif %}
{% endblock %}
